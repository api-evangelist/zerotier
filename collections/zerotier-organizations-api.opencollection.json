          },
          "http": {
            "method": "POST",
            "url": "https://api.zerotier.com/api/v1/org-invitation",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite a user to your organization by email"
        },
        {
          "info": {
            "name": "Get organization invitation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zerotier.com/api/v1/org-invitation/:inviteID",
            "params": [
              {
                "name": "inviteID",
                "value": "",
                "type": "path",
                "description": "Invitation ID"
              }
            ]
          },
          "docs": "Get organization invitation"
        },
        {
          "info": {
            "name": "Accept organization invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zerotier.com/api/v1/org-invitation/:inviteID",
            "params": [
              {
                "name": "inviteID",
                "value": "",
                "type": "path",
                "description": "Invitation ID"
              }
            ]
