            "method": "GET",
            "url": "https://api.zerotier.com/api/v1/org"
          },
          "docs": "Get the current user's organization"
        },
        {
          "info": {
            "name": "Get organization by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zerotier.com/api/v1/org/:orgID",
            "params": [
              {
                "name": "orgID",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              }
            ]
          },
          "docs": "Get organization by ID"
        },
        {
          "info": {
            "name": "Get list of organization members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zerotier.com/api/v1/org/:orgID/user",
