        {
          "info": {
            "name": "Decline organization invitation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zerotier.com/api/v1/org-invitation/:inviteID",
            "params": [
              {
                "name": "inviteID",
                "value": "",
                "type": "path",
                "description": "Invitation ID"
